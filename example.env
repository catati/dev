# catati-dev environment variables: paste into the claude.ai/code form.
# Non-secret values are committed. Secrets stay blank here: fill them only in the form.
# Every user of the environment can read these values, so put dev values only, never production.

# Cloudflare: the "Catati" account. Use a token scoped to dev Workers, D1, R2 and Queues only.
CLOUDFLARE_ACCOUNT_ID=69f8dc2296dd15d29e03693d6492f163
CLOUDFLARE_API_TOKEN=
WRANGLER_SEND_METRICS=false

# Supabase: "Agents DEV" project
SUPABASE_URL=https://gismagaenuxfuhtyxjfc.supabase.co
SUPABASE_SECRET_KEY=

# Shopify dev store
SHOPIFY_SHOP=catati-dev-store.myshopify.com
# Not secret: commit the value once the agents MCP app is confirmed.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_FLAG_STORE_PASSWORD=
# Theme Access password: lets catati-horizon run `shopify theme dev` without a browser login.
SHOPIFY_CLI_THEME_TOKEN=
SHOPIFY_CLI_NO_ANALYTICS=1

# Google: Gmail MCP
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack: product MCP
SLACK_BOT_TOKEN=

# catsper test login
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Xero: agents Xero MCP (mcps/xero). Client ID and tenant name are not secret: commit them once confirmed.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_NAME=
