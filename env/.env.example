# dev environment variables: paste into the claude.ai/code form.
# Non-secret values are committed. Secrets and account identifiers stay blank here: fill them only in the form.
# Every user of the environment can read these values, so put dev values only, never production.
# Only catsper, cat-hotel, terraform and dev variables belong here. A name a tool reads stays as the tool spells it,
# and the shared TEST_ACCOUNT_* login has no prefix. Any other name starts with its repo's stem:
# CAT_HOTEL_, CATSPER_, TERRAFORM_ or DEV_ (conventions/naming.md).

# Cloudflare: the dedicated "catati-dev" account. It holds dev resources only, so the token may have full access inside it.
# CLOUDFLARE_ACCOUNT_ID is the 32-character account ID, not the account name.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WRANGLER_SEND_METRICS=false

# corepack: fetch each repo's pinned pnpm without an interactive prompt
COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# cat-hotel: seeded admin admin@cathotel.nz, for verify-journeys
CAT_HOTEL_ADMIN_PASSWORD=

# cat-hotel: client secret of the dev Shopify app (catati-cat-hotel-dev), for verify-journeys
CAT_HOTEL_SHOPIFY_CLIENT_SECRET=
# Service account token: lets cat-hotel run `shopify app deploy --config dev` without a browser login.
# Create it in the dev store's Shopify admin under Settings > Users > Security, with app management access to the dev app only. Never use a token that can deploy a production app.
SHOPIFY_SERVICE_ACCOUNT_TOKEN=
SHOPIFY_CLI_NO_ANALYTICS=1

# Shared test login: every repo uses this one account in dev
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
